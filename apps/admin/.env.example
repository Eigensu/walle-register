# Backend this admin panel manages (one deploy of apps/admin per event backend). Server-side only:
# the browser calls /api/* and /uploads/* on this site, which next.config.ts proxies here.
ADMIN_API_URL=http://127.0.0.1:8000

# Shown in the header and browser tab, e.g. "JMCL Season 2" or "SYF NSPL".
NEXT_PUBLIC_ADMIN_TITLE=Registration Admin
