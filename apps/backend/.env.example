# Database
MONGO_URL=mongodb://localhost:27017
MONGO_DB=walle_register

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Payment gateways shown to players: razorpay | cashfree | razorpay,cashfree
# (first one is listed first). Change and restart/redeploy the backend to switch.
PAYMENT_GATEWAYS=razorpay

# Razorpay (required when razorpay is in PAYMENT_GATEWAYS)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cashfree (required when cashfree is in PAYMENT_GATEWAYS)
# Dashboard > Developers > API Keys. Use sandbox keys with CASHFREE_ENV=sandbox,
# production keys with CASHFREE_ENV=production.
# Webhook URL to add in the Cashfree dashboard: https://<backend-host>/api/payments/cashfree/webhook
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=sandbox
# CASHFREE_API_VERSION=2025-01-01

# Registration
REGISTRATION_FEE_INR=15000

# Storage (local, s3, cloudinary)
STORAGE_MODE=local
# For Cloudinary:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_FOLDER=walle-register

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
# Required for the admin panel (apps/admin): secret that signs its sessions, 32+ random characters.
# Generate one with: openssl rand -hex 32
# Without it the panel's sign-in returns 503; the rest of the backend is unaffected.
ADMIN_JWT_SECRET=

# Email Configuration
MAIL_USERNAME=jewelleryyouthforum@gmail.com
MAIL_PASSWORD=your_gmail_app_password_16_chars
MAIL_FROM=jewelleryyouthforum@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=JYPL Registration Team
