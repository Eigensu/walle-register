# Public URL of this site (used for metadata, sitemap, OG images)
# Production: https://<syf-domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# development | preview | production
# preview/development show unconfirmed content with a "TBC" badge; production hides it
NEXT_PUBLIC_SITE_ENV=development

# Registration backend (this event's own deployment of apps/backend; server-side only). Leave empty to run on config dates alone.
REGISTRATION_API_URL=http://127.0.0.1:8001

# Optional: pretend it's this moment, to preview phases (ignored in production)
# e.g. 2026-12-10T12:00:00+05:30 (registrations open) or 2027-02-06T11:00:00+05:30 (match day)
NEXT_PUBLIC_FAKE_NOW=
